# SQLite の保存先
PRICEWATCH_DB=data/pricewatch.db
# 同じサイトへのアクセス間隔（秒）。短くしすぎるとブロックされやすい
PRICEWATCH_DELAY=3
# 定期確認の間隔（分）
PRICEWATCH_INTERVAL=60
# 画面のアドレス。家の他のPC・スマホからも見るときは 0.0.0.0 にする（その場合はパスワードも設定）
PRICEWATCH_HOST=127.0.0.1
PRICEWATCH_PORT=8000
# 画面を開くときのパスワード（空欄ならパスワードなし。ユーザー名は何でもよい）
PRICEWATCH_PASSWORD=
# Amazon などボット対策の強いサイトだけブラウザ(Playwright)で取得する
PRICEWATCH_AUTO_BROWSER=0
# すべてのサイトをブラウザで取得する
PRICEWATCH_BROWSER=0

# ---- 通知（設定したものすべてに送信） ----
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
# LINE Messaging API（LINE Notify は 2025/3 に終了）
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TO=
# メール
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=
